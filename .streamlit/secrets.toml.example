# Copy this as .streamlit/secrets.toml for LOCAL use only.
# For Streamlit Cloud: add these via the app's "Secrets" settings page
# (Settings → Secrets → paste the contents below, filled in).
# NEVER commit the real secrets.toml to git.

# ── GitHub (required for remote pipeline triggers from dashboard) ─────────
# Personal Access Token with: repo (read/write) + actions (write) scopes
# Generate at: https://github.com/settings/tokens?type=beta
GH_PAT = "ghp_your_token_here"

# Your GitHub repo in "owner/repo" format
GITHUB_REPO = "Tamilarasan20225/autoapply"

# ── LLM API Keys (required for local pipeline execution) ─────────────────
GROQ_API_KEY = ""
GROQ_API_KEY_2 = ""
GROQ_API_KEY_3 = ""
GEMINI_API_KEY = ""
GEMINI_API_KEY_2 = ""

# ── Job Board APIs ────────────────────────────────────────────────────────
ADZUNA_APP_ID = ""
ADZUNA_APP_KEY = ""
JOOBLE_API_KEY = ""
SERPER_API_KEY = ""

# ── Notifications ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN = ""
TELEGRAM_CHAT_ID = ""
