# AutoAppy — Environment Variables
# Copy this file to .env and fill in your keys

# ─── LLM API Keys (Free Tiers — No Credit Card Required) ─────────────────────

# Google Gemini Flash — Primary LLM (FREE: 1,500 req/day, 1M context)
# Get key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq — Fast Fallback LLM (FREE: 1,000 req/day, 100K tokens/day)
# Get key: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# GitHub Models — Last Resort Fallback (FREE: 150-1000 req/day)
# Get token: https://github.com/settings/tokens (needs "models" permission)
# GITHUB_TOKEN=your_github_token_here

# ─── Job Board APIs ───────────────────────────────────────────────────────────

# Adzuna — Aggregated job board (FREE: 1,000 calls/month)
# Register: https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# ─── Telegram Notifications (Recommended — Free & Instant) ───────────────────
# Get instant alerts on your phone when manual apply is needed!
#
# Setup (5 min):
#   1. Message @BotFather on Telegram → /newbot → get token
#   2. Message your new bot once (send any text)
#   3. Run: python -c "from autoapply.notifier.telegram import get_chat_id; get_chat_id()"
#   4. Copy the chat_id shown and paste below
#
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=987654321

# ─── Email Notifications (Optional) ──────────────────────────────────────────
# For "manual apply" alerts — use Gmail with App Password
# Gmail App Password guide: https://support.google.com/accounts/answer/185833
# SMTP_EMAIL=your_email@gmail.com
# SMTP_PASSWORD=your_gmail_app_password_here
# ALERT_EMAIL=your_email@gmail.com   # Where to receive alerts

# ─── LinkedIn Credentials (for Playwright automation) ─────────────────────────
# These are used by Playwright locally — never sent to any server
# LINKEDIN_EMAIL=your_linkedin_email@gmail.com
# LINKEDIN_PASSWORD=your_linkedin_password_here
