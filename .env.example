# AutoAppy — Environment Variables
# Copy this file to .env and fill in your keys

# ─── LLM API Keys (Free Tiers — No Credit Card Required) ─────────────────────
# You can add multiple keys per provider (e.g. from separate free accounts) —
# they are pooled and rotated automatically when one hits a rate limit/quota.

# Groq — Fast, high-quota LLM — PRIMARY provider (FREE: 1,000 req/day/key, 100K tokens/day)
# Get key: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
# GROQ_API_KEY_2=your_second_groq_api_key_here
# GROQ_API_KEY_3=your_third_groq_api_key_here

# Google Gemini Flash — Secondary LLM, more prone to rate limits (FREE: 1,500 req/day/key, 1M context)
# Get key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY_2=your_second_gemini_api_key_here

# GitHub Models — Last Resort Fallback (FREE: 150-1000 req/day)
# Get token: https://github.com/settings/tokens (needs "models" permission)
# GITHUB_TOKEN=your_github_token_here

# ─── Job Board APIs ───────────────────────────────────────────────────────────
# These also support multiple pooled accounts using the same _2/_3 suffix convention.

# Adzuna — Aggregated job board (FREE: 1,000 calls/month per app)
# Register: https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
# ADZUNA_APP_ID_2=your_second_adzuna_app_id_here
# ADZUNA_APP_KEY_2=your_second_adzuna_app_key_here

# Jooble — Global job aggregator with strong India coverage (FREE: 500 req/month per key)
# Register: https://jooble.org/api/registered  (fill form, get key in ~1 day)
# JOOBLE_API_KEY=your_jooble_api_key_here
# JOOBLE_API_KEY_2=your_second_jooble_api_key_here

# ─── Search APIs ──────────────────────────────────────────────────────────────

# Serper — Google SERP API for ATS job discovery (FREE: 100 searches/month per key)
# Get key: https://serper.dev/  (no credit card for free tier)
# SERPER_API_KEY=your_serper_api_key_here
# SERPER_API_KEY_2=your_second_serper_api_key_here

# ─── Telegram Notifications (Recommended — Free & Instant) ───────────────────
# Get instant alerts on your phone when manual apply is needed!
#
# Setup (5 min):
#   1. Message @BotFather on Telegram → /newbot → get token
#   2. Message your new bot once (send any text)
#   3. Run: python -c "from autoapply.notifier.telegram import get_chat_id; get_chat_id()"
#   4. Copy the chat_id shown and paste below
#
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=987654321

# ─── Email Notifications (Optional) ──────────────────────────────────────────
# For "manual apply" alerts — use Gmail with App Password
# Gmail App Password guide: https://support.google.com/accounts/answer/185833
# SMTP_EMAIL=your_email@gmail.com
# SMTP_PASSWORD=your_gmail_app_password_here
# ALERT_EMAIL=your_email@gmail.com   # Where to receive alerts

# ─── LinkedIn Credentials (for Playwright automation) ─────────────────────────
# These are used by Playwright locally — never sent to any server
# LINKEDIN_EMAIL=your_linkedin_email@gmail.com
# LINKEDIN_PASSWORD=your_linkedin_password_here
